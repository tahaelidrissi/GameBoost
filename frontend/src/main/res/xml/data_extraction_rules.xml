<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
           Règles de sauvegarde cloud pour Android 12+ (API 31+)
           Documentation: https://developer.android.com/about/versions/12/backup-restore
        -->
        <exclude domain="sharedpref" path="." />
        <include domain="sharedpref" path="gamecoach_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Règles pour le transfert entre appareils -->
        <exclude domain="sharedpref" path="." />
        <include domain="sharedpref" path="gamecoach_prefs.xml" />
    </device-transfer>
</data-extraction-rules>